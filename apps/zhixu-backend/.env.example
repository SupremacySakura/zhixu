# ==========================================
# Cloud Drive Backend - 环境变量配置文件
# ==========================================
# 复制此文件为 .env 并修改为你自己的配置
# 警告：生产环境必须修改所有默认值！
# ==========================================

# ==========================================
# 服务器配置
# ==========================================
PORT=9000

# ==========================================
# 数据库配置 (MySQL)
# ==========================================
DB_USER=root
DB_PASSWORD=123456123456
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=zhixu

# ==========================================
# JWT 认证配置
# ==========================================
# ⚠️ 必填：所有环境（包括本地开发）都必须设置至少 32 个字符的强随机密钥。
# 启动时会拒绝空值、已知占位值和短密钥。
# 生成命令：openssl rand -hex 32
JWT_SECRET=

# ==========================================
# CORS 配置
# ==========================================
# 允许的前端应用来源，逗号分隔，例如 http://localhost:3000,https://myapp.com
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ==========================================
# 文件存储路径
# ==========================================
# 分片上传临时存储路径
CHUNK_STORAGE_PATH=./data
# 合并后文件存储路径
FILE_STORAGE_PATH=./data
