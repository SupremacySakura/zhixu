OPENAI_API_KEY=

# Chat history storage (shared with backend database)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=zhixu

# Shared secret with backend for internal routes. Generate: openssl rand -hex 32
# Must match INTERNAL_API_SECRET in the backend env.
INTERNAL_API_SECRET=

# Origin of the Go backend (knowledge search and health probes).
CHAT_BACKEND_URL=http://127.0.0.1:9000

# Listen address. Keep 127.0.0.1 unless the backend runs in a container and
# reaches this process through the host gateway; 0.0.0.0 exposes every interface.
MASTRA_HOST=127.0.0.1

# Comma-separated hostnames or literal IPs trusted for plain HTTP and private
# addresses (for local model servers, any port). The Go backend origin is
# exempted separately and exactly; every other outbound hop must be HTTPS.
# Literal IPs also need a matching MODEL_ALLOWED_PRIVATE_ENDPOINTS entry on the
# backend. Without this entry the guard rejects the embedding request and
# knowledge retrieval fails with 502.
# Local Ollama example: EGRESS_ALLOWED_HOSTS=127.0.0.1
# EGRESS_ALLOWED_HOSTS=
