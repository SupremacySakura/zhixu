{
  "name": "zhixu",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:ai": "pnpm --filter zhixu-ai dev",
    "build": "pnpm --filter zhixu-frontend build",
    "build:ai": "pnpm --filter zhixu-ai build",
    "start:ai": "pnpm --filter zhixu-ai start",
    "typecheck:ai": "pnpm --filter zhixu-ai typecheck",
    "build:backend": "cd apps/zhixu-backend && go build ./...",
    "typecheck": "pnpm --filter zhixu-frontend typecheck",
    "lint": "eslint \"apps/**/*.{ts,tsx,js,jsx,vue}\"",
    "check:world": "pnpm --filter zhixu-frontend check:world",
    "check:icons": "pnpm --filter zhixu-frontend check:icons",
    "clean": "tsc -b --clean",
    "prepare": "husky",
    "test": "pnpm --filter zhixu-frontend test:run",
    "test:backend": "cd apps/zhixu-backend && go test ./...",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:world && pnpm check:icons && pnpm build:backend && pnpm test:backend"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@typescript-eslint/eslint-plugin": "^8.27.0",
    "@typescript-eslint/parser": "^8.27.0",
    "eslint": "^9.22.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "typescript": "^5.8.2"
  }
}