# Local development only; copied to .env.development.
PORT=9000
DEV_FRONTEND_PORT=5173
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# Set this to your local MySQL account password.
DB_PASSWORD=your_local_mysql_password
DB_NAME=zhixu
JWT_SECRET=local-development-only-change-for-production
# Optional until storing model API keys. Generate once: openssl rand -base64 32
# Keep this stable and backed up; changing it makes existing credentials unreadable.
MODEL_CONFIG_ENCRYPTION_KEY=
# Start the native AI service separately with pnpm dev:ai.
CHAT_AI_URL=http://127.0.0.1:4111
CHAT_BACKEND_URL=http://127.0.0.1:9000
# Start Qdrant as a native local process; pnpm dev never starts Docker.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
# Exact base URLs allowed for local models, comma separated; public HTTPS needs no entry.
MODEL_ALLOWED_PRIVATE_ENDPOINTS=
# Shared secret between backend and Mastra internal routes. Generate: openssl rand -hex 32
# Must match INTERNAL_API_SECRET in apps/zhixu-ai/.env
INTERNAL_API_SECRET=
APP_ENV=development
LOG_LEVEL=debug
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Paths are relative to apps/zhixu-backend.
CHUNK_STORAGE_PATH=../../data/dev/files
FILE_STORAGE_PATH=../../data/dev/files
